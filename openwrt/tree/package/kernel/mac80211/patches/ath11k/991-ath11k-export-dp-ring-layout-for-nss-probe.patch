+++ b/drivers/net/wireless/ath/ath11k/nss.h
@@ -0,0 +1,125 @@
+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+/*
+ * The NSS wifili offload, inside the driver.
+ *
+ * Qualcomm's own driver hands its data path to the NSS core from
+ * ath11k_core_pdev_create(), between ath11k_dp_pdev_alloc() and
+ * ath11k_mac_register(): every ring exists by then, and mac80211 has not yet
+ * been told the radio is there.  This is the same three messages - INIT,
+ * PDEV_INIT, START - sent from the same place.
+ *
+ * Until now they came from nss_wifili_probe.ko, which ath11k called through a
+ * function pointer the module installed.  That worked, but it put the glue
+ * outside the driver: the ordering had to be arranged in /etc/modules.d, a
+ * failed handover left a radio unable to receive, and every hook was a pointer
+ * read from softirq context with no lock.  nss_export.c stays - the probe is
+ * still useful as a diagnostic and is the only consumer of that API - and
+ * while both exist the nss_inbuilt module parameter picks between them.
+ */
+#ifndef ATH11K_NSS_H
+#define ATH11K_NSS_H
+
+#include <linux/types.h>
+
+struct ath11k_base;
+struct device;
+struct net_device;
+
+/* NSS_WIFILI_MAX_NUMBER_OF_PAGE_MSG.  Checked against it in nss.c. */
+#define ATH11K_NSS_MAX_TX_PAGES		32
+
+/*
+ * Peer memory is indexed by peer id, so this bounds the ids NSS will be told
+ * about.  ath11k's own table for this board is larger; a peer beyond this is
+ * refused rather than silently written past the end of the array.
+ */
+#define ATH11K_NSS_MAX_PEERS		128
+
+/*
+ * Per-SoC state.  One of these lives on struct ath11k_base, which is the
+ * whole point of being in the driver: the probe kept the same fields in an
+ * array indexed by a slot number derived from the chip id, and three separate
+ * dual-radio bugs were one instance of that array being reached from the wrong
+ * radio.
+ *
+ * ctx is void * so that this header does not have to pull in the NSS ones;
+ * it is a struct nss_ctx_instance *.
+ */
+struct ath11k_nss_soc {
+	/* the handover completed and NSS owns this SoC's data path */
+	bool enabled;
+
+	/* wifili interface: internal, or one of the external ones */
+	int if_num;
+
+	/* the radio dynamic interface a pdev hangs off, and its thread scheme */
+	int radio_if_num;
+	u8 scheme_id;
+
+	void *ctx;
+
+	/*
+	 * Every NSS register call wants a netdev.  The SoC- and radio-level
+	 * registrations have no real one to give - they carry control messages,
+	 * not frames - so they get this.
+	 */
+	struct net_device *dummy;
+
+	struct device *dma_dev;
+
+	/* the Tx descriptor pool handed to the firmware */
+	int tx_pages;
+	int tx_ext_first_page;
+	void *tx_page_va[ATH11K_NSS_MAX_TX_PAGES];
+	dma_addr_t tx_page_pa[ATH11K_NSS_MAX_TX_PAGES];
+
+	/*
+	 * One AP vdev per radio, which is what this board runs and what the
+	 * message sequence was validated against.  A second vdev on the same
+	 * radio would need this per arvif rather than per SoC.
+	 */
+	int vdev_if_num;
+	struct net_device *vdev_ndev;
+
+	/* the AP's own BSS peer, and the station currently associated */
+	int self_peer_id;
+	int peer_created;
+	int peer_auth_sent;
+
+	void *peer_mem_va[ATH11K_NSS_MAX_PEERS];
+	dma_addr_t peer_mem_pa[ATH11K_NSS_MAX_PEERS];
+};
+
+/* Is there an NSS core on this platform at all? */
+bool ath11k_nss_available(void);
+
+/*
+ * Hand this SoC's data path over.  Called from ath11k_core_pdev_create() with
+ * ab->core_lock held; this is the QMI worker, so sleeping is fine and blocking
+ * delays only ath11k_mac_register().
+ *
+ * Returns 0 when NSS owns the data path.  On any error the caller must leave
+ * the SoC on the host path.
+ */
+int ath11k_nss_setup(struct ath11k_base *ab);
+
+/* Give it back.  Safe to call when setup never ran, and idempotent. */
+void ath11k_nss_teardown(struct ath11k_base *ab);
+
+struct ath11k_nss_vif;
+struct ath11k_nss_peer;
+struct sk_buff;
+
+/* An AP interface appeared, or is going away. */
+int ath11k_nss_vdev_create(struct ath11k_base *ab,
+			   const struct ath11k_nss_vif *vif);
+void ath11k_nss_vdev_delete(struct ath11k_base *ab);
+
+/* A station changed state.  Idempotent - it is called again at AUTHORIZED. */
+int ath11k_nss_peer_update(struct ath11k_base *ab,
+			   const struct ath11k_nss_peer *peer, bool create);
+
+/* Hand a frame to NSS instead of putting it in TCL. */
+int ath11k_nss_tx(struct ath11k_base *ab, struct sk_buff *skb, u32 vdev_id);
+
+#endif /* ATH11K_NSS_H */
--- /dev/null
+++ b/drivers/net/wireless/ath/ath11k/nss.c
@@ -0,0 +1,1467 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/*
+ * NSS wifili offload for ath11k.  See nss.h for why this is here.
+ *
+ * This is a transliteration of the bring-up sequence that nss_wifili_probe.ko
+ * arrived at, not a fresh implementation of it: the message layouts, the field
+ * values and the order they are sent in are the ones that were measured, and
+ * the comments that record why a value is what it is have been carried across
+ * with it.  The differences are structural - state lives on struct ath11k_base
+ * instead of in a slot-indexed array, and nothing is reached through a
+ * function pointer - plus the diagnostic knobs are gone.  Those stay in the
+ * probe, which is still the right tool for asking the firmware questions.
+ */
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/delay.h>
+#include <linux/dma-mapping.h>
+#include <linux/netdevice.h>
+#include <linux/etherdevice.h>
+
+#include <nss_api_if.h>
+#include <nss_wifili_if.h>
+#include <nss_dynamic_interface.h>
+#include <nss_wifi_vdev.h>
+
+#include "core.h"
+#include "debug.h"
+#include "ath11k_nss_export.h"
+#include "nss.h"
+
+/*
+ * One handover at a time.  Both SoCs reach ath11k_core_pdev_create() from
+ * their own QMI worker and on this board they arrive about 100 ms apart, so
+ * without this they interleave.  Their own state is per-ab and safe, but the
+ * NSS allocators they call - nss_get_available_wifili_external_if() and
+ * nss_dynamic_interface_alloc_node() - hand out from one global pool.  The
+ * probe never met this because it serialised every run behind its own mutex.
+ */
+static DEFINE_MUTEX(ath11k_nss_setup_lock);
+
+/*
+ * nss_wifili_msg_init() is EXPORT_SYMBOL()ed by qca-nss-drv but never declared
+ * in its exported headers - the same omission the upstream feed patched for
+ * nss_wifili_get_context().  Declare it rather than patch that driver.
+ */
+extern void nss_wifili_msg_init(struct nss_wifili_msg *ncm, uint16_t if_num,
+				uint32_t type, uint32_t len, void *cb,
+				void *app_data);
+
+/*
+ * The Tx descriptor pool.  The firmware fixes the descriptor sizes; the host
+ * hands it whole pages and says where the extended descriptors start.
+ *
+ * 245760 divides by both 80 and 160 exactly.  The previous 64 KiB page divided
+ * neither, so the last descriptor of a page had only part of itself inside it
+ * and the write ran past the allocation - corruption whose symptom depended on
+ * what happened to be next in memory.
+ */
+#define ATH11K_NSS_TX_DESC_SZ		80
+#define ATH11K_NSS_TX_EXT_DESC_SZ	160
+#define ATH11K_NSS_TX_PAGE_SZ		245760
+#define ATH11K_NSS_NUM_TX_DESC		4096
+
+/*
+ * WLAN_CFG_RX_SW_DESC_NUM_SIZE from the vendor's cfg_dp.h, QCA_LOWMEM_CONFIG
+ * branch - the profile this 256 MB board builds as.  Measured against 1024
+ * (ath11k's own refill ring size) over twelve runs: throughput is identical
+ * within the run-to-run spread, but rx_desc_alloc_fail goes from roughly two
+ * thirds of reo_reaped to exactly zero.
+ */
+#define ATH11K_NSS_RX_SW_DESC_NUM	4096
+
+/*
+ * nss_wifili_init_msg.flags.  The stripped vendor wifi_3_0.ko sets 0x40
+ * unconditionally in two QSDK generations, which makes it a premise rather
+ * than a feature.  The four documented bits (CCE_DISABLED, ADDTL_MEM_SEG_SET,
+ * PEXT_STATS_ENABLED, MULTISOC_THREAD_MAP_ENABLE) all apply to configurations
+ * this board does not have.
+ */
+#define ATH11K_NSS_INIT_FLAGS		0x40
+
+/* soc_mem_profile: the vendor binary writes 1 unconditionally. */
+#define ATH11K_NSS_MEM_PROFILE		1
+
+#define ATH11K_NSS_INTERNODE_Q		1024
+#define ATH11K_NSS_TX_DEVICE_LIMIT	65536
+
+/*
+ * How many REO destination rings to declare.  NSS reaps ring 0 only, and
+ * ath11k_nss_dp_reo_to_ring0() points every hash bucket at it before the
+ * firmware is told about the rings, so declaring the other three would
+ * describe rings nothing ever services.
+ */
+#define ATH11K_NSS_NUM_REO_RINGS	1
+
+/*
+ * htt_pkt_type_ethernet, which is also what ath11k's frame_mode=2 and
+ * HAL_TCL_ENCAP_TYPE_ETHERNET mean.  The hardware decaps to Ethernet and NSS
+ * has to be told to expect that; with the firmware's own default it receives
+ * 802.11 + RFC1042 SNAP, cannot parse it, matches no rule, and excepts every
+ * frame to Linux.
+ */
+#define ATH11K_NSS_ENCAP_TYPE		2
+#define ATH11K_NSS_DECAP_TYPE		2
+
+/* cdp_sec_type: 6 is AES-CCMP, which is what WPA2 on this AP negotiates. */
+#define ATH11K_NSS_SEC_TYPE		6
+
+/*
+ * NSS_WIFILI_PEER_UPDATE_AUTH_FLAG.  The header in this qca-nss-drv numbers it
+ * 43; the firmware answers only to 44, and the vendor binary sends 44.
+ */
+#define ATH11K_NSS_PEER_AUTH_MSG	44
+
+/* Per-peer state NSS keeps in host DRAM. */
+#define ATH11K_NSS_PEER_MEM_SZ		1600
+
+/*
+ * The vdev base next hop.  NSS_ETH_RX_INTERFACE (158) hands a received frame
+ * to NSS's own Ethernet Rx processing, which is what lets it reach eth1
+ * without Linux seeing it; 0 leaves it unset, and every frame is delivered to
+ * the netdev the vdev was registered with instead.
+ */
+static unsigned int ath11k_nss_next_hop = NSS_ETH_RX_INTERFACE;
+module_param_named(nss_next_hop, ath11k_nss_next_hop, uint, 0444);
+MODULE_PARM_DESC(nss_next_hop,
+		 "vdev base next hop; 0 delivers received frames to the netdev");
+
+/*
+ * Which ath11k_base owns a netdev.  The per-vdev NSS callbacks are handed the
+ * netdev and nothing else, so this is the way back to the SoC.  Two entries,
+ * one per wifili instance, indexed by the same slot ath11k_nss_soc_slot()
+ * returns.
+ */
+#define ATH11K_NSS_SOCS			2
+static struct ath11k_base *ath11k_nss_ndev_owner[ATH11K_NSS_SOCS];
+
+static atomic_t ath11k_nss_rx_data = ATOMIC_INIT(0);
+static atomic_t ath11k_nss_rx_ext = ATOMIC_INIT(0);
+static atomic_t ath11k_nss_rx_noab = ATOMIC_INIT(0);
+static atomic_t ath11k_nss_rx_short = ATOMIC_INIT(0);
+static atomic_t ath11k_nss_rx_eapol = ATOMIC_INIT(0);
+static atomic_t ath11k_nss_rx_up = ATOMIC_INIT(0);
+static atomic_t ath11k_nss_rx_extdrop = ATOMIC_INIT(0);
+
+static int ath11k_nss_rxstats_get(char *buf, const struct kernel_param *kp)
+{
+	return scnprintf(buf, PAGE_SIZE,
+			 "data=%d ext=%d noab=%d short=%d eapol=%d up=%d extdrop=%d\n",
+			 atomic_read(&ath11k_nss_rx_data),
+			 atomic_read(&ath11k_nss_rx_ext),
+			 atomic_read(&ath11k_nss_rx_noab),
+			 atomic_read(&ath11k_nss_rx_short),
+			 atomic_read(&ath11k_nss_rx_eapol),
+			 atomic_read(&ath11k_nss_rx_up),
+			 atomic_read(&ath11k_nss_rx_extdrop));
+}
+
+static const struct kernel_param_ops ath11k_nss_rxstats_ops = {
+	.get = ath11k_nss_rxstats_get,
+};
+module_param_cb(nss_rxstats, &ath11k_nss_rxstats_ops, NULL, 0444);
+
+static struct ath11k_base *ath11k_nss_ab_of_netdev(struct net_device *dev)
+{
+	unsigned int i;
+
+	for (i = 0; i < ATH11K_NSS_SOCS; i++) {
+		struct ath11k_base *ab = READ_ONCE(ath11k_nss_ndev_owner[i]);
+
+		if (ab && ab->nss.vdev_ndev == dev)
+			return ab;
+	}
+	return NULL;
+}
+
+/* ------------------------------------------------------------------ replies */
+
+/*
+ * The firmware emits unsolicited events on the same callback as replies, at
+ * about 1 Hz under load.  Deciding by message type alone missed them: the one
+ * this firmware actually sends is type 16, NSS_WIFILI_WDS_ACTIVE_INFO_MSG, and
+ * an earlier filter that only knew about type 10 let nine of them through in a
+ * single run.  The robust test is the response field - NOTIFY means "event,
+ * not answer" whatever the type is - and the type list is belt and braces for
+ * firmware that sends an event with a response of 0.
+ */
+static bool ath11k_nss_msg_is_event(const struct nss_wifili_msg *msg)
+{
+	switch (msg->cm.type) {
+	case 10:	/* NSS_WIFILI_STATS_MSG */
+	case 12:	/* NSS_WIFILI_PEER_STATS_MSG */
+	case 16:	/* NSS_WIFILI_WDS_ACTIVE_INFO_MSG */
+	case 41:	/* NSS_WIFILI_PEER_4ADDR_EVENT_MSG */
+	case 53:	/* NSS_WIFILI_ASTENTRY_SYNC_MSG */
+	case 54:	/* NSS_WIFILI_MECENTRY_SYNC_MSG */
+		return true;
+	default:
+		return msg->cm.response == NSS_CMN_RESPONSE_NOTIFY;
+	}
+}
+
+/*
+ * nss_wifili_tx_msg_sync() does the waiting and returns the verdict, so this
+ * exists only to put the firmware's own error number in the log - the status
+ * code says "it failed", the error number says what it objected to.
+ */
+/*
+ * Set while the STOP and SOC_RESET that clear a previous life are in flight.
+ * On a cold boot both are refused, and their replies should not be warnings.
+ */
+static bool ath11k_nss_quiet;
+
+static void ath11k_nss_event_cb(void *app_data, struct nss_wifili_msg *msg)
+{
+	struct ath11k_base *ab = app_data;
+
+	if (!msg)
+		return;
+
+	if (ath11k_nss_msg_is_event(msg))
+		return;
+
+	if (msg->cm.response != NSS_CMN_RESPONSE_ACK && ab && !ath11k_nss_quiet)
+		ath11k_warn(ab, "nss: reply type=%u response=%u error=%u\n",
+			    msg->cm.type, msg->cm.response, msg->cm.error);
+}
+
+/*
+ * Registered because the register calls require one.  Frames arrive on the
+ * per-vdev callbacks, not here; anything that turns up is a surprise worth one
+ * line in the log.
+ */
+static void ath11k_nss_data_cb(struct net_device *dev, struct sk_buff *skb,
+			       struct napi_struct *napi)
+{
+	pr_warn_once("ath11k: nss: unexpected frame on a control interface\n");
+	dev_kfree_skb_any(skb);
+}
+
+static int ath11k_nss_send_simple(struct ath11k_base *ab, u32 type,
+				  const char *what, bool may_fail)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifili_msg *msg;
+	nss_tx_status_t status;
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+
+	nss_wifili_msg_init(msg, nss->if_num, type, 0,
+			    ath11k_nss_event_cb, ab);
+	status = nss_wifili_tx_msg_sync(nss->ctx, msg);
+	kfree(msg);
+
+	if (status != NSS_TX_SUCCESS) {
+		if (may_fail)
+			ath11k_dbg(ab, ATH11K_DBG_BOOT,
+				   "nss: %s declined (%d), expected on a core that has not run\n",
+				   what, status);
+		else
+			ath11k_warn(ab, "nss: %s failed (%d)\n", what, status);
+		return -EIO;
+	}
+
+	ath11k_dbg(ab, ATH11K_DBG_BOOT, "nss: %s ok\n", what);
+	return 0;
+}
+
+/* --------------------------------------------------------- Tx descriptors */
+
+static void ath11k_nss_free_tx_pages(struct ath11k_base *ab)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	int i;
+
+	for (i = 0; i < nss->tx_pages; i++)
+		if (nss->tx_page_va[i])
+			dma_free_coherent(nss->dma_dev, ATH11K_NSS_TX_PAGE_SZ,
+					  nss->tx_page_va[i],
+					  nss->tx_page_pa[i]);
+
+	memset(nss->tx_page_va, 0, sizeof(nss->tx_page_va));
+	nss->tx_pages = 0;
+	nss->tx_ext_first_page = 0;
+}
+
+static int ath11k_nss_alloc_tx_pages(struct ath11k_base *ab, struct device *dev)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	u32 reg_bytes, ext_bytes;
+	int reg_pages, ext_pages, total, i;
+
+	BUILD_BUG_ON(ATH11K_NSS_MAX_TX_PAGES !=
+		     NSS_WIFILI_MAX_NUMBER_OF_PAGE_MSG);
+
+	if (nss->tx_pages)
+		return 0;
+
+	/* one spare descriptor: the firmware indexes from 1 */
+	reg_bytes = ATH11K_NSS_TX_DESC_SZ * (ATH11K_NSS_NUM_TX_DESC + 1);
+	ext_bytes = ATH11K_NSS_TX_EXT_DESC_SZ * (ATH11K_NSS_NUM_TX_DESC + 1);
+	reg_pages = DIV_ROUND_UP(reg_bytes, ATH11K_NSS_TX_PAGE_SZ);
+	ext_pages = DIV_ROUND_UP(ext_bytes, ATH11K_NSS_TX_PAGE_SZ);
+	total = reg_pages + ext_pages;
+
+	if (total > ATH11K_NSS_MAX_TX_PAGES) {
+		ath11k_warn(ab, "nss: tx pool needs %d pages, max %d\n",
+			    total, ATH11K_NSS_MAX_TX_PAGES);
+		return -ENOMEM;
+	}
+
+	nss->dma_dev = dev;
+	for (i = 0; i < total; i++) {
+		nss->tx_page_va[i] = dma_alloc_coherent(dev,
+							ATH11K_NSS_TX_PAGE_SZ,
+							&nss->tx_page_pa[i],
+							GFP_KERNEL);
+		if (!nss->tx_page_va[i]) {
+			ath11k_warn(ab, "nss: tx pool page %d failed\n", i);
+			nss->tx_pages = i;
+			ath11k_nss_free_tx_pages(ab);
+			return -ENOMEM;
+		}
+	}
+
+	nss->tx_pages = total;
+	nss->tx_ext_first_page = reg_pages;
+
+	ath11k_dbg(ab, ATH11K_DBG_BOOT,
+		   "nss: tx pool %d desc, %d regular + %d ext pages, ext at %d\n",
+		   ATH11K_NSS_NUM_TX_DESC, reg_pages, ext_pages, reg_pages);
+	return 0;
+}
+
+/* -------------------------------------------------------- radio interface */
+
+/*
+ * The radio interface type has to match the wifili interface it hangs off: an
+ * external SoC's radio is EXTERNAL0/1, not INTERNAL.  Getting this wrong gets
+ * a node NSS will not associate with the pdev - the firmware took the
+ * PDEV_INIT and then died between it and START.
+ */
+static enum nss_dynamic_interface_type
+ath11k_nss_radio_di_type(struct ath11k_base *ab)
+{
+	if (ab->nss.if_num == NSS_WIFILI_INTERNAL_INTERFACE)
+		return NSS_DYNAMIC_INTERFACE_TYPE_WIFILI_INTERNAL;
+
+	return ab->nss.if_num == NSS_WIFILI_EXTERNAL_INTERFACE1 ?
+		NSS_DYNAMIC_INTERFACE_TYPE_WIFILI_EXTERNAL1 :
+		NSS_DYNAMIC_INTERFACE_TYPE_WIFILI_EXTERNAL0;
+}
+
+/*
+ * The vendor does this before every PDEV_INIT: allocate a dynamic interface of
+ * the wifili radio type, register it, then ask for a thread scheme against it.
+ * scheme_id is the only part that reaches the firmware, but the firmware
+ * validates it - NSS_WIFILI_EMSG_PDEV_INIT_FAIL_INVALID_THREAD_SCHEME_ID
+ * exists - so a hardcoded 0 is not the same as one the allocator handed out.
+ */
+static int ath11k_nss_radio_if_alloc(struct ath11k_base *ab)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_ctx_instance *rctx;
+	int ifnum;
+
+	if (nss->radio_if_num >= 0)
+		return 0;
+
+	ifnum = nss_dynamic_interface_alloc_node(ath11k_nss_radio_di_type(ab));
+	if (ifnum < 0) {
+		ath11k_warn(ab, "nss: radio interface alloc failed (%d)\n",
+			    ifnum);
+		return ifnum;
+	}
+
+	rctx = nss_register_wifili_radio_if(ifnum, ath11k_nss_data_cb,
+					    ath11k_nss_data_cb,
+					    ath11k_nss_event_cb,
+					    nss->dummy, 0);
+	if (!rctx) {
+		ath11k_warn(ab, "nss: radio interface %d register failed\n",
+			    ifnum);
+		nss_dynamic_interface_dealloc_node(ifnum,
+					ath11k_nss_radio_di_type(ab));
+		return -ENODEV;
+	}
+
+	nss->radio_if_num = ifnum;
+	nss->scheme_id = nss_wifili_thread_scheme_alloc(nss->ctx, ifnum,
+						NSS_WIFILI_LOW_PRIORITY_SCHEME);
+
+	ath11k_dbg(ab, ATH11K_DBG_BOOT, "nss: radio if=%d scheme_id=%u\n",
+		   ifnum, nss->scheme_id);
+	return 0;
+}
+
+static void ath11k_nss_radio_if_free(struct ath11k_base *ab)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+
+	if (nss->radio_if_num < 0)
+		return;
+
+	nss_wifili_thread_scheme_dealloc(nss->ctx, nss->radio_if_num);
+	nss_unregister_wifili_radio_if(nss->radio_if_num);
+	nss_dynamic_interface_dealloc_node(nss->radio_if_num,
+					   ath11k_nss_radio_di_type(ab));
+	nss->radio_if_num = -1;
+	nss->scheme_id = 0;
+}
+
+/* ------------------------------------------------------------------- rings */
+
+static void ath11k_nss_fill_srng(struct nss_wifili_hal_srng_info *dst,
+				 const struct ath11k_nss_srng *src)
+{
+	int i;
+
+	memset(dst, 0, sizeof(*dst));
+	if (!src->valid)
+		return;
+
+	dst->ring_id		= src->ring_id;
+	dst->ring_base_paddr	= src->ring_base_paddr;
+	dst->num_entries	= src->num_entries;
+	dst->flags		= src->flags;
+	dst->ring_dir		= src->ring_dir;
+	dst->entry_size		= src->entry_size;
+
+	for (i = 0; i < NSS_WIFILI_MAX_SRNG_REG_GROUPS_MSG &&
+		    i < ATH11K_NSS_NUM_REG_GRP; i++)
+		dst->hwreg_base[i] = src->hwreg_base[i];
+}
+
+/* --------------------------------------------------------------- PDEV_INIT */
+
+/*
+ * Control messages all go to the SoC interface: nss_wifili_tx_msg() rejects
+ * anything else outright, and the vendor confirms it - nss_wifili_pdev_attach()
+ * calls nss_cmn_msg_init() with the SoC interface number even though it has
+ * just allocated a radio interface.  radio_id in the payload selects the radio.
+ */
+static int ath11k_nss_send_pdev_init(struct ath11k_base *ab,
+				     const struct ath11k_nss_dp_info *info,
+				     unsigned int r)
+{
+	const struct ath11k_nss_pdev *p = &info->pdev[r];
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifili_pdev_init_msg *pi;
+	struct nss_wifili_msg *msg;
+	nss_tx_status_t status;
+	int ret;
+
+	if (!p->valid)
+		return 0;
+
+	ret = ath11k_nss_radio_if_alloc(ab);
+	if (ret)
+		return ret;
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+
+	pi = &msg->msg.pdevmsg;
+	ath11k_nss_fill_srng(&pi->rxdma_ring, &p->rxdma_ring);
+	pi->radio_id		= p->radio_id;
+	pi->lmac_id		= p->lmac_id;
+	pi->target_pdev_id	= p->target_pdev_id;
+	pi->num_rx_swdesc	= ATH11K_NSS_RX_SW_DESC_NUM;
+	pi->hwmode		= 0;
+	pi->scheme_id		= nss->scheme_id;
+
+	nss_wifili_msg_init(msg, nss->if_num, NSS_WIFILI_PDEV_INIT_MSG,
+			    sizeof(struct nss_wifili_pdev_init_msg),
+			    ath11k_nss_event_cb, ab);
+
+	status = nss_wifili_tx_msg_sync(nss->ctx, msg);
+	kfree(msg);
+
+	if (status != NSS_TX_SUCCESS) {
+		ath11k_warn(ab, "nss: PDEV_INIT radio %u failed (%d)\n",
+			    r, status);
+		ath11k_nss_radio_if_free(ab);
+		return -EIO;
+	}
+
+	ath11k_dbg(ab, ATH11K_DBG_BOOT,
+		   "nss: PDEV_INIT radio=%u lmac=%u target_pdev=%u swdesc=%u scheme=%u\n",
+		   r, p->lmac_id, p->target_pdev_id,
+		   ATH11K_NSS_RX_SW_DESC_NUM, nss->scheme_id);
+	return 0;
+}
+
+/* -------------------------------------------------------------------- INIT */
+
+static int ath11k_nss_send_init(struct ath11k_base *ab,
+				const struct ath11k_nss_dp_info *info)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifili_init_msg *init;
+	struct nss_wifili_msg *msg;
+	nss_tx_status_t status;
+	unsigned int i;
+	int ret;
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+
+	init = &msg->msg.init;
+	init->hssm.dev_base_addr	 = info->dev_base_paddr;
+	init->hssm.shadow_rdptr_mem_addr = info->shadow_rdptr_paddr;
+	init->hssm.shadow_wrptr_mem_addr = info->shadow_wrptr_paddr;
+	init->hssm.lmac_rings_start_id	 = info->lmac_rings_start_id;
+
+	/*
+	 * Declare only rings that were actually allocated.  An early run
+	 * claimed three TCL rings where this hardware has one and the firmware
+	 * did not object, so its validation cannot be relied on to catch this.
+	 */
+	init->num_tcl_data_rings = 0;
+	for (i = 0; i < info->num_tcl_data_rings; i++)
+		if (info->tcl_ring[i].valid)
+			init->num_tcl_data_rings++;
+
+	init->num_reo_dest_rings = 0;
+	for (i = 0; i < info->num_reo_dest_rings; i++)
+		if (info->reo_dest_ring[i].valid)
+			init->num_reo_dest_rings++;
+
+	if (init->num_reo_dest_rings > ATH11K_NSS_NUM_REO_RINGS)
+		init->num_reo_dest_rings = ATH11K_NSS_NUM_REO_RINGS;
+
+	init->target_type	= info->nss_target_type;
+	init->wrip.tlv_size	= info->rx_tlv_size;
+	init->wrip.rx_buf_len	= info->rx_buf_len;
+	init->soc_mem_profile	= ATH11K_NSS_MEM_PROFILE;
+	init->flags		= ATH11K_NSS_INIT_FLAGS;
+
+	for (i = 0; i < info->num_tcl_data_rings; i++) {
+		ath11k_nss_fill_srng(&init->tcl_ring_info[i],
+				     &info->tcl_ring[i]);
+		ath11k_nss_fill_srng(&init->tx_comp_ring[i],
+				     &info->tx_comp_ring[i]);
+	}
+	for (i = 0; i < info->num_reo_dest_rings; i++)
+		ath11k_nss_fill_srng(&init->reo_dest_ring[i],
+				     &info->reo_dest_ring[i]);
+
+	ath11k_nss_fill_srng(&init->reo_exception_ring,
+			     &info->reo_exception_ring);
+	ath11k_nss_fill_srng(&init->rx_rel_ring, &info->rx_rel_ring);
+	ath11k_nss_fill_srng(&init->reo_reinject_ring,
+			     &info->reo_reinject_ring);
+
+	ret = ath11k_nss_alloc_tx_pages(ab, info->dma_dev);
+	if (ret) {
+		kfree(msg);
+		return ret;
+	}
+
+	init->wtdim.num_tx_desc		= ATH11K_NSS_NUM_TX_DESC;
+	init->wtdim.num_tx_desc_ext	= ATH11K_NSS_NUM_TX_DESC;
+	init->wtdim.num_pool		= info->num_radios ? : 1;
+	init->wtdim.num_memaddr		= nss->tx_pages;
+	init->wtdim.ext_desc_page_num	= nss->tx_ext_first_page;
+	init->wtdim.num_tx_device_limit	= ATH11K_NSS_TX_DEVICE_LIMIT;
+	init->tx_sw_internode_queue_size = ATH11K_NSS_INTERNODE_Q;
+	for (i = 0; i < (unsigned int)nss->tx_pages; i++) {
+		init->wtdim.memory_addr[i] = (u32)nss->tx_page_pa[i];
+		init->wtdim.memory_size[i] = ATH11K_NSS_TX_PAGE_SZ;
+	}
+
+	ath11k_dbg(ab, ATH11K_DBG_BOOT,
+		   "nss: INIT tcl=%u reo=%u tlv=%u rx_buf_len=%u target=%u\n",
+		   init->num_tcl_data_rings, init->num_reo_dest_rings,
+		   init->wrip.tlv_size, init->wrip.rx_buf_len,
+		   init->target_type);
+
+	nss_wifili_msg_init(msg, nss->if_num, NSS_WIFILI_INIT_MSG,
+			    sizeof(struct nss_wifili_init_msg),
+			    ath11k_nss_event_cb, ab);
+
+	status = nss_wifili_tx_msg_sync(nss->ctx, msg);
+	kfree(msg);
+
+	if (status != NSS_TX_SUCCESS) {
+		ath11k_warn(ab, "nss: INIT rejected (%d)\n", status);
+		return -EIO;
+	}
+
+	return 0;
+}
+
+
+/* ============================================================ the peer half */
+
+/*
+ * NSS keeps its own per-peer state in host DRAM and is told where.  The block
+ * is mapped for the device and stays mapped for the life of the peer; the
+ * index is the peer id, which is what every later message uses to name it.
+ */
+static void ath11k_nss_peer_mem_free(struct ath11k_base *ab, u32 pid)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+
+	if (pid >= ATH11K_NSS_MAX_PEERS || !nss->peer_mem_va[pid])
+		return;
+
+	dma_unmap_single(nss->dma_dev, nss->peer_mem_pa[pid],
+			 ATH11K_NSS_PEER_MEM_SZ, DMA_TO_DEVICE);
+	kfree(nss->peer_mem_va[pid]);
+	nss->peer_mem_va[pid] = NULL;
+	nss->peer_mem_pa[pid] = 0;
+}
+
+static int ath11k_nss_peer_delete(struct ath11k_base *ab, u32 peer_id)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifili_msg *msg;
+	nss_tx_status_t status;
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+
+	msg->msg.peermsg.peer_id = peer_id;
+
+	nss_wifili_msg_init(msg, nss->if_num, NSS_WIFILI_PEER_DELETE_MSG,
+			    sizeof(struct nss_wifili_peer_msg),
+			    ath11k_nss_event_cb, ab);
+
+	status = nss_wifili_tx_msg_sync(nss->ctx, msg);
+	kfree(msg);
+
+	ath11k_nss_peer_mem_free(ab, peer_id);
+
+	if (status != NSS_TX_SUCCESS) {
+		ath11k_warn(ab, "nss: PEER_DELETE %u failed (%d)\n",
+			    peer_id, status);
+		return -EIO;
+	}
+
+	ath11k_dbg(ab, ATH11K_DBG_MAC, "nss: peer %u deleted\n", peer_id);
+	return 0;
+}
+
+/*
+ * The cipher, per peer, for both the pairwise and the group key.  pkt_type 0
+ * is the group key and 1 the pairwise one; the vendor sends both.
+ */
+static void ath11k_nss_peer_security(struct ath11k_base *ab, u32 peer_id)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifili_msg *msg;
+	nss_tx_status_t status;
+	int pkt_type;
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return;
+
+	for (pkt_type = 0; pkt_type < 2; pkt_type++) {
+		memset(msg, 0, sizeof(*msg));
+		msg->msg.securitymsg.peer_id	   = peer_id;
+		msg->msg.securitymsg.pkt_type	   = pkt_type;
+		msg->msg.securitymsg.security_type = ATH11K_NSS_SEC_TYPE;
+
+		nss_wifili_msg_init(msg, nss->if_num,
+				    NSS_WIFILI_PEER_SECURITY_TYPE_MSG,
+				    sizeof(struct nss_wifili_peer_security_type_msg),
+				    ath11k_nss_event_cb, ab);
+
+		status = nss_wifili_tx_msg_sync(nss->ctx, msg);
+		if (status != NSS_TX_SUCCESS)
+			ath11k_warn(ab, "nss: PEER_SECURITY %u/%d failed (%d)\n",
+				    peer_id, pkt_type, status);
+		msleep(20);
+	}
+
+	kfree(msg);
+}
+
+/*
+ * A peer NSS considers unauthorised is one whose frames it refuses to forward,
+ * which is the shape of "reo_reaped climbs and rx_deliverd stays zero".
+ */
+static int ath11k_nss_peer_auth(struct ath11k_base *ab, u32 peer_id,
+				bool authorized)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifili_msg *msg;
+	nss_tx_status_t status;
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+
+	msg->msg.peer_auth.peer_id   = peer_id;
+	msg->msg.peer_auth.auth_flag = authorized ? 1 : 0;
+
+	nss_wifili_msg_init(msg, nss->if_num, ATH11K_NSS_PEER_AUTH_MSG,
+			    sizeof(struct nss_wifili_peer_update_auth_flag),
+			    ath11k_nss_event_cb, ab);
+
+	status = nss_wifili_tx_msg_sync(nss->ctx, msg);
+	kfree(msg);
+
+	if (status != NSS_TX_SUCCESS) {
+		ath11k_warn(ab, "nss: PEER_AUTH %u failed (%d)\n",
+			    peer_id, status);
+		return -EIO;
+	}
+
+	ath11k_info(ab, "nss: peer %u authorised=%d\n", peer_id, authorized);
+	return 0;
+}
+
+static int ath11k_nss_peer_create(struct ath11k_base *ab,
+				  const struct ath11k_nss_peer *peer)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifili_peer_msg *pm;
+	struct nss_wifili_msg *msg;
+	nss_tx_status_t status;
+	u32 pid = peer->peer_id;
+
+	if (pid >= ATH11K_NSS_MAX_PEERS) {
+		ath11k_warn(ab, "nss: peer id %u past the peer table\n", pid);
+		return -EINVAL;
+	}
+
+	if (!nss->dma_dev)
+		return -ENODEV;
+
+	ath11k_nss_peer_mem_free(ab, pid);
+
+	nss->peer_mem_va[pid] = kzalloc(ATH11K_NSS_PEER_MEM_SZ, GFP_KERNEL);
+	if (!nss->peer_mem_va[pid])
+		return -ENOMEM;
+
+	nss->peer_mem_pa[pid] = dma_map_single(nss->dma_dev,
+					       nss->peer_mem_va[pid],
+					       ATH11K_NSS_PEER_MEM_SZ,
+					       DMA_TO_DEVICE);
+	if (dma_mapping_error(nss->dma_dev, nss->peer_mem_pa[pid])) {
+		kfree(nss->peer_mem_va[pid]);
+		nss->peer_mem_va[pid] = NULL;
+		return -ENOMEM;
+	}
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg) {
+		ath11k_nss_peer_mem_free(ab, pid);
+		return -ENOMEM;
+	}
+
+	pm = &msg->msg.peermsg;
+	ether_addr_copy(pm->peer_mac_addr, peer->mac_addr);
+	pm->vdev_id	     = peer->vdev_id;
+	pm->peer_id	     = peer->peer_id;
+	pm->hw_ast_idx	     = peer->hw_peer_id;
+	pm->tx_ast_hash	     = peer->ast_hash;
+	pm->nss_peer_mem     = (u32)nss->peer_mem_pa[pid];
+	pm->psta_vdev_id     = peer->vdev_id;
+	pm->peer_memory_size = ATH11K_NSS_PEER_MEM_SZ;
+
+	nss_wifili_msg_init(msg, nss->if_num, NSS_WIFILI_PEER_CREATE_MSG,
+			    sizeof(*pm), ath11k_nss_event_cb, ab);
+
+	status = nss_wifili_tx_msg_sync(nss->ctx, msg);
+	kfree(msg);
+
+	if (status != NSS_TX_SUCCESS) {
+		ath11k_warn(ab, "nss: PEER_CREATE %pM (%u) failed (%d)\n",
+			    peer->mac_addr, peer->peer_id, status);
+		ath11k_nss_peer_mem_free(ab, pid);
+		return -EIO;
+	}
+
+	ath11k_info(ab, "nss: peer %pM id %u vdev %u ast_hash %u hw_ast %u\n",
+		    peer->mac_addr, peer->peer_id, peer->vdev_id,
+		    peer->ast_hash, peer->hw_peer_id);
+	return 0;
+}
+
+/*
+ * The AP's own BSS peer.  NSS will not forward for a vdev whose own peer it
+ * does not know, and ath11k has already created it by the time the vdev is
+ * built - so find it among the peers ath11k has and pass it on.
+ */
+static void ath11k_nss_self_peer_create(struct ath11k_base *ab, const u8 *mac)
+{
+	struct ath11k_nss_peer peers[ATH11K_NSS_MAX_PEER];
+	struct ath11k_nss_soc *nss = &ab->nss;
+	int np, i, slot;
+
+	if (nss->self_peer_id >= 0 || !nss->dma_dev)
+		return;
+
+	slot = ath11k_nss_soc_slot(ab);
+	if (slot < 0)
+		return;
+
+	np = ath11k_nss_get_peers(slot, peers, ARRAY_SIZE(peers));
+	for (i = 0; i < np; i++) {
+		if (!peers[i].valid ||
+		    !ether_addr_equal(peers[i].mac_addr, mac))
+			continue;
+
+		if (!ath11k_nss_peer_create(ab, &peers[i])) {
+			nss->self_peer_id = peers[i].peer_id;
+			ath11k_nss_peer_security(ab, peers[i].peer_id);
+		}
+		return;
+	}
+
+	ath11k_warn(ab, "nss: no self peer for %pM among %d\n", mac, np);
+	return;
+}
+
+/*
+ * ath11k's sta_state transitions, as they arrive.  It is called again at
+ * ASSOC->AUTHORIZED with the same peer, so it has to be idempotent: the peer
+ * is already there and only the flag has moved.
+ */
+int ath11k_nss_peer_update(struct ath11k_base *ab,
+			   const struct ath11k_nss_peer *peer, bool create)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	int ret;
+
+	if (!nss->enabled || nss->vdev_if_num < 0)
+		return -ENODEV;
+
+	if (!create) {
+		if (nss->peer_created != (int)peer->peer_id)
+			return 0;
+		ath11k_nss_peer_delete(ab, peer->peer_id);
+		nss->peer_created = -1;
+		nss->peer_auth_sent = -1;
+		return 0;
+	}
+
+	/* A station that re-associates arrives with a new peer id. */
+	if (nss->peer_created >= 0 && nss->peer_created != (int)peer->peer_id) {
+		ath11k_nss_peer_delete(ab, nss->peer_created);
+		nss->peer_created = -1;
+		nss->peer_auth_sent = -1;
+	}
+
+	if (nss->peer_created >= 0) {
+		if (nss->peer_auth_sent != !!peer->is_authorized &&
+		    !ath11k_nss_peer_auth(ab, peer->peer_id,
+					  peer->is_authorized))
+			nss->peer_auth_sent = !!peer->is_authorized;
+		return 0;
+	}
+
+	ret = ath11k_nss_peer_create(ab, peer);
+	if (ret)
+		return ret;
+
+	ath11k_nss_peer_security(ab, peer->peer_id);
+	nss->peer_created = peer->peer_id;
+	nss->peer_auth_sent = -1;
+
+	if (peer->is_authorized &&
+	    !ath11k_nss_peer_auth(ab, peer->peer_id, true))
+		nss->peer_auth_sent = 1;
+
+	return 0;
+}
+
+
+/* =========================================================== the vdev half */
+
+/*
+ * One AP vdev per radio, which is what this board runs and what the message
+ * sequence below was validated against.  A second vdev on the same radio would
+ * need this state per arvif rather than per SoC; nothing here assumes it is
+ * impossible, it simply has not been built or tested.
+ */
+
+static void ath11k_nss_vdev_cmd(struct ath11k_base *ab, int ifnum, u32 cmd,
+				u32 value, const char *name)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifi_vdev_msg *msg;
+	nss_tx_status_t status;
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg)
+		return;
+
+	msg->msg.vdev_cmd.cmd	= cmd;
+	msg->msg.vdev_cmd.value	= value;
+
+	nss_wifi_vdev_msg_init(msg, ifnum, NSS_WIFI_VDEV_INTERFACE_CMD_MSG,
+			       sizeof(struct nss_wifi_vdev_cmd_msg),
+			       NULL, NULL);
+
+	status = nss_wifi_vdev_tx_msg(nss->ctx, msg);
+	if (status != NSS_TX_SUCCESS)
+		ath11k_warn(ab, "nss: vdev %d cmd %s (%u) = %u failed (%d)\n",
+			    ifnum, name, cmd, value, status);
+
+	kfree(msg);
+}
+
+/*
+ * Excepted frames: NSS reaped this one from REO, resolved its peer, and had
+ * nowhere better to send it - a broadcast, an ARP, a DHCP discover, an EAPOL,
+ * or a flow ECM has not accelerated yet.
+ */
+static void ath11k_nss_rx_deliver(struct ath11k_base *ab,
+				  struct net_device *dev, struct sk_buff *skb)
+{
+	int slot;
+
+	if (!dev) {
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	if (skb->len < ETH_HLEN) {
+		atomic_inc(&ath11k_nss_rx_short);
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	/*
+	 * With frame_mode=2 the hardware decaps to Ethernet and what arrives
+	 * here is already 802.3.  Convert anything that is still 802.11.
+	 *
+	 * ieee80211_is_data() alone cannot tell the two apart: it reads the
+	 * first two bytes as a frame control field, and for an Ethernet frame
+	 * those are the first two bytes of the destination MAC.  A DA
+	 * beginning 28:d0 gives fc = 0xd028, whose type reads as DATA, and the
+	 * frame would be mangled.  Requiring the RFC1042 SNAP header at the
+	 * 802.11 payload offset settles it - no Ethernet frame carries that
+	 * there.
+	 */
+	if (skb->len >= sizeof(struct ieee80211_hdr_3addr)) {
+		struct ieee80211_hdr *h11 = (struct ieee80211_hdr *)skb->data;
+		static const u8 snap[6] = { 0xaa, 0xaa, 0x03, 0x00, 0x00, 0x00 };
+		unsigned int hl = ieee80211_hdrlen(h11->frame_control);
+
+		if (ieee80211_is_data(h11->frame_control) &&
+		    skb->len >= hl + sizeof(snap) &&
+		    !memcmp(skb->data + hl, snap, sizeof(snap))) {
+			if (ieee80211_data_to_8023_exthdr(skb, NULL,
+							  dev->dev_addr,
+							  NL80211_IFTYPE_AP,
+							  0, false)) {
+				dev_kfree_skb_any(skb);
+				return;
+			}
+		}
+	}
+
+	/*
+	 * EAPOL goes to mac80211, not to the bridge: hostapd listens on the
+	 * nl80211 control port, which only mac80211's receive path feeds.
+	 * Delivering it to the AP netdev reaches the bridge and nothing else,
+	 * and the four-way handshake never completes.
+	 */
+	slot = ath11k_nss_soc_slot(ab);
+	if (slot >= 0 && !ath11k_nss_dp_rx_eapol(slot, 0, skb)) {
+		atomic_inc(&ath11k_nss_rx_eapol);
+		return;
+	}
+
+	skb->dev = dev;
+	skb->protocol = eth_type_trans(skb, dev);
+	skb_reset_network_header(skb);
+	skb->pkt_type = PACKET_HOST;
+	skb->ip_summed = CHECKSUM_NONE;
+	skb->next = NULL;
+
+	/*
+	 * No dev_sw_netstats_rx_add(): that writes through dev->tstats, the
+	 * per-cpu block a driver opts into, and a mac80211 netdev leaves the
+	 * pointer unset.  mac80211 accounts for what it receives itself.
+	 */
+	atomic_inc(&ath11k_nss_rx_up);
+	netif_receive_skb(skb);
+}
+
+static void ath11k_nss_vdev_data_cb(struct net_device *dev,
+				    struct sk_buff *skb,
+				    struct napi_struct *napi)
+{
+	struct ath11k_base *ab = ath11k_nss_ab_of_netdev(dev);
+
+	atomic_inc(&ath11k_nss_rx_data);
+	if (!ab) {
+		atomic_inc(&ath11k_nss_rx_noab);
+		dev_kfree_skb_any(skb);
+		return;
+	}
+	ath11k_nss_rx_deliver(ab, dev, skb);
+}
+
+/*
+ * The extended callback carries two different things with a type in the
+ * headroom: frames NSS is excepting, and notifications wearing an skb - Tx
+ * completions, Rx error reports, PPDU metadata.  Delivering the notifications
+ * to the stack unexamined hands the bridge things that are not frames, so the
+ * type has to be looked at.
+ *
+ * MCBC_RX is the one that matters and the one that was missed.  It is what
+ * MCBC_EXC_TO_HOST produces, so every broadcast from a station arrives here:
+ * dropping it means no DHCP discover and no ARP ever reach the host, and a
+ * client associates, completes the handshake and then cannot get an address.
+ * Measured while it was being dropped: 237 frames on this callback, all type
+ * 14, and two on the data callback - the EAPOL pair, which is why the
+ * handshake worked and nothing else did.
+ */
+static void ath11k_nss_vdev_ext_cb(struct net_device *dev, struct sk_buff *skb,
+				   struct napi_struct *napi)
+{
+	struct nss_wifi_vdev_per_packet_metadata *md;
+	struct ath11k_base *ab = ath11k_nss_ab_of_netdev(dev);
+
+	atomic_inc(&ath11k_nss_rx_ext);
+	if (!ab) {
+		atomic_inc(&ath11k_nss_rx_noab);
+		dev_kfree_skb_any(skb);
+		return;
+	}
+
+	md = (struct nss_wifi_vdev_per_packet_metadata *)
+		(skb->head + NSS_WIFI_VDEV_PER_PACKET_METADATA_OFFSET);
+
+	switch (md->pkt_type) {
+	/* frames */
+	case NSS_WIFI_VDEV_EXT_DATA_PKT_TYPE_NONE:
+	case NSS_WIFI_VDEV_EXT_DATA_PKT_TYPE_IGMP:
+	case NSS_WIFI_VDEV_EXT_DATA_PKT_TYPE_WDS_LEARN:
+	case NSS_WIFI_VDEV_EXT_DATA_PKT_TYPE_MCBC_RX:
+	case NSS_WIFI_VDEV_EXT_DATA_PKT_TYPE_4ADDR:
+	case NSS_WIFI_VDEV_EXT_DATA_PKT_TYPE_EAPOL:
+		ath11k_nss_rx_deliver(ab, dev, skb);
+		return;
+	/* notifications: TXINFO, RX_ERR, TX_COMPL, PPDU/MPDU info, ... */
+	default:
+		atomic_inc(&ath11k_nss_rx_extdrop);
+		pr_info_once("ath11k: nss: ext pkt_type %u dropped\n",
+			     md->pkt_type);
+		dev_kfree_skb_any(skb);
+		return;
+	}
+}
+
+static void ath11k_nss_vdev_msg_cb(void *app_data, struct nss_cmn_msg *msg)
+{
+}
+
+/*
+ * Hand a frame ath11k was about to put in TCL to NSS instead.  Called from
+ * ath11k_nss_dp_tx(), which has already converted an 802.11 frame to 802.3.
+ */
+int ath11k_nss_tx(struct ath11k_base *ab, struct sk_buff *skb, u32 vdev_id)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	nss_tx_status_t status;
+
+	if (nss->vdev_if_num < 0 || !nss->ctx)
+		return -ENODEV;
+
+	if (skb->len <= ETH_HLEN)
+		return -EINVAL;
+
+	/*
+	 * NSS writes its own headers in front of a full-size frame, and a
+	 * short headroom is what a converted 802.11 frame arrives with.
+	 */
+	if (skb->len > ETH_FRAME_LEN && skb_headroom(skb) <= 23 &&
+	    pskb_expand_head(skb, 24, 0, GFP_ATOMIC))
+		return -ENOMEM;
+
+	skb->next = NULL;
+	status = nss_wifi_vdev_tx_buf(nss->ctx, skb, nss->vdev_if_num);
+	if (status != NSS_TX_SUCCESS)
+		return -EIO;
+
+	/* NSS owns the skb now; ath11k treats this as queued to TCL. */
+	return 0;
+}
+
+int ath11k_nss_vdev_create(struct ath11k_base *ab,
+			   const struct ath11k_nss_vif *vif)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct nss_wifi_vdev_config_msg *cfg;
+	struct nss_wifi_vdev_msg *msg;
+	nss_tx_status_t status;
+	int ifnum;
+
+	if (!nss->enabled || nss->vdev_if_num >= 0)
+		return 0;
+
+	if (nss->radio_if_num < 0) {
+		ath11k_warn(ab, "nss: no radio interface; PDEV_INIT first\n");
+		return -EINVAL;
+	}
+
+	ifnum = nss_dynamic_interface_alloc_node(NSS_DYNAMIC_INTERFACE_TYPE_VAP);
+	if (ifnum < 0) {
+		ath11k_warn(ab, "nss: vdev interface alloc failed (%d)\n",
+			    ifnum);
+		return ifnum;
+	}
+
+	/*
+	 * vif->netdev as it arrives: no reference, no name.  See the note on
+	 * struct ath11k_nss_vif in ath11k_nss_export.h for why both are
+	 * unavailable at this point and why the bare pointer is safe.
+	 */
+	nss->vdev_ndev = vif->netdev;
+	if (!nss->vdev_ndev) {
+		ath11k_warn(ab, "nss: vif has no netdev; excepted frames will be lost\n");
+		nss->vdev_ndev = nss->dummy;
+	}
+
+	/*
+	 * No return check.  nss_register_wifi_vdev_if() is declared uint32_t
+	 * but its own documentation says "@return None", and on the path that
+	 * works it returns 0 - so testing it turns every successful
+	 * registration into a failure.  There is no way to tell from here
+	 * whether it worked; the VDEV_CONFIGURE that follows is what reports.
+	 */
+	nss_register_wifi_vdev_if(nss->ctx, ifnum,
+				  ath11k_nss_vdev_data_cb,
+				  ath11k_nss_vdev_ext_cb,
+				  ath11k_nss_vdev_msg_cb,
+				  nss->vdev_ndev, 0);
+
+	msg = kzalloc(sizeof(*msg), GFP_KERNEL);
+	if (!msg) {
+		nss_unregister_wifi_vdev_if(ifnum);
+		nss_dynamic_interface_dealloc_node(ifnum,
+					NSS_DYNAMIC_INTERFACE_TYPE_VAP);
+		return -ENOMEM;
+	}
+
+	cfg = &msg->msg.vdev_config;
+	ether_addr_copy(cfg->mac_addr, vif->mac_addr);
+	cfg->radio_ifnum = nss->radio_if_num;
+	cfg->vdev_id	 = vif->vdev_id;
+	cfg->opmode	 = vif->nss_opmode;
+
+	nss_wifi_vdev_msg_init(msg, ifnum,
+			       NSS_WIFI_VDEV_INTERFACE_CONFIGURE_MSG,
+			       sizeof(*cfg), NULL, NULL);
+	status = nss_wifi_vdev_tx_msg(nss->ctx, msg);
+	if (status != NSS_TX_SUCCESS) {
+		ath11k_warn(ab, "nss: VDEV_CONFIGURE failed (%d)\n", status);
+		kfree(msg);
+		nss_unregister_wifi_vdev_if(ifnum);
+		nss_dynamic_interface_dealloc_node(ifnum,
+					NSS_DYNAMIC_INTERFACE_TYPE_VAP);
+		return -EIO;
+	}
+
+	memset(msg, 0, sizeof(*msg));
+	ether_addr_copy(msg->msg.vdev_enable.mac_addr, vif->mac_addr);
+	nss_wifi_vdev_msg_init(msg, ifnum, NSS_WIFI_VDEV_INTERFACE_UP_MSG,
+			       sizeof(struct nss_wifi_vdev_enable_msg),
+			       NULL, NULL);
+	status = nss_wifi_vdev_tx_msg(nss->ctx, msg);
+	if (status != NSS_TX_SUCCESS)
+		ath11k_warn(ab, "nss: VDEV_UP failed (%d)\n", status);
+	kfree(msg);
+
+	/*
+	 * The vendor ends its vap_create with this.  An interface NSS believes
+	 * has no MTU is not one it will hand a frame to, which is the shape of
+	 * "reaped from REO but never delivered".
+	 */
+	nss_if_change_mtu(nss->ctx, ifnum, ETH_DATA_LEN);
+
+	/*
+	 * Tell the vdev what its frames look like.  Leaving these to the
+	 * firmware's defaults is how the encapsulation ends up as raw or
+	 * native-wifi while ath11k is handing it Ethernet.
+	 */
+	ath11k_nss_vdev_cmd(ab, ifnum, NSS_WIFI_VDEV_ENCAP_TYPE_CMD,
+			    ATH11K_NSS_ENCAP_TYPE, "ENCAP_TYPE");
+	ath11k_nss_vdev_cmd(ab, ifnum, NSS_WIFI_VDEV_DECAP_TYPE_CMD,
+			    ATH11K_NSS_DECAP_TYPE, "DECAP_TYPE");
+	ath11k_nss_vdev_cmd(ab, ifnum, NSS_WIFI_VDEV_DROP_UNENC_CMD,
+			    0, "DROP_UNENC");
+
+	/*
+	 * MCBC_EXC_TO_HOST is what lets a DHCP discover reach dnsmasq at all.
+	 * AP_BRIDGE is the station-to-station forwarding an AP owes its
+	 * clients.
+	 */
+	ath11k_nss_vdev_cmd(ab, ifnum, NSS_WIFI_VDEV_CFG_MCBC_EXC_TO_HOST_CMD,
+			    1, "MCBC_EXC_TO_HOST");
+	ath11k_nss_vdev_cmd(ab, ifnum, NSS_WIFI_VDEV_CFG_AP_BRIDGE_CMD,
+			    1, "AP_BRIDGE");
+
+	/*
+	 * Where a received frame goes next.  NSS_ETH_RX_INTERFACE hands it to
+	 * NSS's own Ethernet Rx processing - the bridging and routing lookup,
+	 * and from there to an accelerated flow.  It is the reason a WiFi frame
+	 * can reach eth1 without Linux seeing it, and it is worth 27 % of the
+	 * downlink: without it four runs gave 320 Mbit/s scattered 246-373,
+	 * with it 406 inside 383-418.
+	 */
+	if (ath11k_nss_next_hop) {
+		status = nss_wifi_vdev_base_set_next_hop(nss->ctx,
+							 ath11k_nss_next_hop);
+		if (status != NSS_TX_SUCCESS)
+			ath11k_warn(ab, "nss: base next hop -> %u failed (%d)\n",
+				    ath11k_nss_next_hop, status);
+	}
+
+	nss->vdev_if_num = ifnum;
+
+	/*
+	 * Only now, and only after vdev_ndev is set: the per-vdev callbacks
+	 * find their SoC through this, and NSS can call them as soon as the
+	 * interface is up.
+	 */
+	{
+		int slot = ath11k_nss_soc_slot(ab);
+
+		if (slot >= 0 && slot < ATH11K_NSS_SOCS)
+			WRITE_ONCE(ath11k_nss_ndev_owner[slot], ab);
+	}
+
+	ath11k_info(ab, "nss: vdev %d up for vdev_id %u on %s\n",
+		    ifnum, vif->vdev_id,
+		    nss->vdev_ndev ? nss->vdev_ndev->name : "(none)");
+
+	/* The AP's own BSS peer, which NSS needs before it will forward. */
+	ath11k_nss_self_peer_create(ab, vif->mac_addr);
+	return 0;
+}
+
+void ath11k_nss_vdev_delete(struct ath11k_base *ab)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	int ifnum = xchg(&nss->vdev_if_num, -1);
+
+	if (ifnum < 0)
+		return;
+
+	if (nss->peer_created >= 0) {
+		ath11k_nss_peer_delete(ab, nss->peer_created);
+		nss->peer_created = -1;
+		nss->peer_auth_sent = -1;
+	}
+	if (nss->self_peer_id >= 0) {
+		ath11k_nss_peer_delete(ab, nss->self_peer_id);
+		nss->self_peer_id = -1;
+	}
+
+	nss_unregister_wifi_vdev_if(ifnum);
+	nss_dynamic_interface_dealloc_node(ifnum,
+					   NSS_DYNAMIC_INTERFACE_TYPE_VAP);
+
+	{
+		int slot = ath11k_nss_soc_slot(ab);
+
+		if (slot >= 0 && slot < ATH11K_NSS_SOCS)
+			WRITE_ONCE(ath11k_nss_ndev_owner[slot], NULL);
+	}
+	nss->vdev_ndev = NULL;
+}
+
+/* ------------------------------------------------------------------- setup */
+
+bool ath11k_nss_available(void)
+{
+	return nss_cmn_get_nss_enabled();
+}
+
+static int ath11k_nss_wifili_register(struct ath11k_base *ab, int slot)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+
+	if (nss->ctx)
+		return 0;
+
+	/*
+	 * Slot 0 is the internal radio and takes the internal wifili
+	 * interface; anything else asks for one of the external ones.  The
+	 * slot itself comes from the chip id, not from probe order.
+	 */
+	if (slot == 0) {
+		nss->if_num = NSS_WIFILI_INTERNAL_INTERFACE;
+	} else {
+		nss->if_num = nss_get_available_wifili_external_if();
+		if (nss->if_num == -1) {
+			ath11k_warn(ab, "nss: no external wifili interface\n");
+			return -ENODEV;
+		}
+	}
+
+	nss->ctx = nss_register_wifili_if(nss->if_num, ath11k_nss_data_cb,
+					  ath11k_nss_data_cb,
+					  ath11k_nss_event_cb, nss->dummy, 0);
+	if (!nss->ctx) {
+		ath11k_warn(ab, "nss: wifili interface %d register failed\n",
+			    nss->if_num);
+		return -ENODEV;
+	}
+
+	ath11k_dbg(ab, ATH11K_DBG_BOOT, "nss: wifili interface %d registered\n",
+		   nss->if_num);
+	return 0;
+}
+
+int ath11k_nss_setup(struct ath11k_base *ab)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+	struct ath11k_nss_dp_info *info;
+	unsigned int i;
+	int slot, ret;
+
+	if (nss->enabled)
+		return 0;
+
+	if (!ath11k_nss_available()) {
+		ath11k_warn(ab, "nss: no NSS core on this platform\n");
+		return -ENOTSUPP;
+	}
+
+	slot = ath11k_nss_soc_slot(ab);
+	if (slot < 0) {
+		ath11k_warn(ab, "nss: no wifili slot for this chip\n");
+		return -ENOTSUPP;
+	}
+
+	nss->radio_if_num = -1;
+	nss->vdev_if_num = -1;
+	nss->self_peer_id = -1;
+	nss->peer_created = -1;
+	nss->peer_auth_sent = -1;
+
+	info = kzalloc(sizeof(*info), GFP_KERNEL);
+	if (!info)
+		return -ENOMEM;
+
+	mutex_lock(&ath11k_nss_setup_lock);
+
+	ret = ath11k_nss_get_dp_info(slot, info);
+	if (ret) {
+		ath11k_warn(ab, "nss: cannot read the data path layout (%d)\n",
+			    ret);
+		goto free_info;
+	}
+
+	if (!nss->dummy) {
+		nss->dummy = alloc_netdev_dummy(0);
+		if (!nss->dummy) {
+			ret = -ENOMEM;
+			goto free_info;
+		}
+	}
+
+	ret = ath11k_nss_wifili_register(ab, slot);
+	if (ret)
+		goto free_dummy;
+
+	/*
+	 * Narrow the REO hash map to destination ring 0 before the firmware is
+	 * told about the rings.  NSS reaps ring 0 only; with ath11k's four-way
+	 * hash split in place most frames land in rings nothing services.
+	 */
+	ret = ath11k_nss_dp_reo_to_ring0(slot);
+	if (ret)
+		ath11k_warn(ab, "nss: could not narrow the REO hash map (%d)\n",
+			    ret);
+
+	/*
+	 * Clear whatever a previous life left in the firmware.  On a cold boot
+	 * there is nothing to clear and both of these answer with an error,
+	 * which is why they are not checked - but ath11k_core_reconfigure_on_
+	 * crash() runs this whole path again on a live NSS core, and there a
+	 * reset that is not preceded by a stop is refused outright
+	 * (NSS_WIFILI_EMSG_RESET_NO_STOP exists for exactly that).
+	 */
+	ath11k_nss_quiet = true;
+	ath11k_nss_send_simple(ab, NSS_WIFILI_STOP_MSG, "STOP", true);
+	msleep(100);
+	ath11k_nss_send_simple(ab, NSS_WIFILI_SOC_RESET_MSG, "SOC_RESET", true);
+	ath11k_nss_quiet = false;
+	msleep(200);
+
+	ret = ath11k_nss_send_init(ab, info);
+	if (ret)
+		goto unregister;
+
+	for (i = 0; i < ATH11K_NSS_MAX_PDEV; i++) {
+		ret = ath11k_nss_send_pdev_init(ab, info, i);
+		if (ret)
+			goto unregister;
+	}
+	msleep(200);
+
+	ret = ath11k_nss_send_simple(ab, NSS_WIFILI_START_MSG, "START", false);
+	if (ret)
+		goto unregister;
+	msleep(200);
+
+	nss->enabled = true;
+	mutex_unlock(&ath11k_nss_setup_lock);
+	kfree(info);
+	ath11k_info(ab, "nss: data path handed over\n");
+	return 0;
+
+unregister:
+	ath11k_nss_radio_if_free(ab);
+	nss_unregister_wifili_if(nss->if_num);
+	nss->ctx = NULL;
+	ath11k_nss_free_tx_pages(ab);
+free_dummy:
+	free_netdev(nss->dummy);
+	nss->dummy = NULL;
+	mutex_unlock(&ath11k_nss_setup_lock);
+	kfree(info);
+	return ret;
+
+free_info:
+	mutex_unlock(&ath11k_nss_setup_lock);
+	kfree(info);
+	return ret;
+}
+
+void ath11k_nss_teardown(struct ath11k_base *ab)
+{
+	struct ath11k_nss_soc *nss = &ab->nss;
+
+	if (!nss->ctx)
+		return;
+
+	ath11k_nss_vdev_delete(ab);
+
+	if (nss->enabled) {
+		ath11k_nss_send_simple(ab, NSS_WIFILI_STOP_MSG, "STOP", false);
+		msleep(100);
+		ath11k_nss_send_simple(ab, NSS_WIFILI_SOC_RESET_MSG,
+				       "SOC_RESET", false);
+		nss->enabled = false;
+	}
+
+	ath11k_nss_radio_if_free(ab);
+	nss_unregister_wifili_if(nss->if_num);
+	nss->ctx = NULL;
+
+	ath11k_nss_free_tx_pages(ab);
+
+	if (nss->dummy) {
+		free_netdev(nss->dummy);
+		nss->dummy = NULL;
+	}
+}
