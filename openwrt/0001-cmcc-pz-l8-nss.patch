+			0x0c 0x00000080		/* PORT6_PAD_MODE  */
+			0x10 0x002613a0		/* POWER_ON_STRAP  */
+			0xe4 0x000aa545		/* MAC_POWER_SEL   */
+			0xe0 0xc74164de		/* SGMII_CTRL      */
+			0x7c 0x0000004e		/* PORT0_STATUS: 1000M/full/rx+tx */
+			0x94 0x0000004e		/* PORT6_STATUS: 1000M/full/rx+tx */
+		>;
