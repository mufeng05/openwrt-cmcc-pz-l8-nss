+	ISISC_ENABLE=$(SSDK_ISISC) MHT_ENABLE=disable \
+	IN_QCA803X_PHY=$(SSDK_QCA803X_PHY) IN_QCA808X_PHY=$(SSDK_QCA808X_PHY) \
