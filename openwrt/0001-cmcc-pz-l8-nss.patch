+# Per-subtarget SSDK feature selection.
+#
+# Upstream hard-disables every chip/PHY driver on the make command line,
+# which overrides ssdk's own ./config (a command-line variable always wins).
+# On ipq50xx that leaves qca-ssdk.ko with zero ISISC symbols, so it cannot
+# drive an external QCA8337 at all - boards like cmcc,pz-l8 were forced onto
+# the mainline qca8k DSA driver, whose 2-byte tag the NSS firmware cannot
+# parse.  Re-enable what ssdk's own config would have selected for MP:
+#   ISISC_ENABLE     - AR8327/AR8337 (QCA8337) chip driver
+#   SWCONFIG_FEATURE - swconfig/UCI front end (config switch / switch_vlan)
+#
+# The PHY drivers stay at their upstream FALSE: this board only needs ssdk
+# for the *external* QCA8337, and enabling IN_MP_PHY / IN_QCA803X_PHY /
+# IN_QCA808X_PHY makes ssdk register phylib drivers that compete with the
+# mainline IPQ5018 GE PHY and qca83xx drivers for the same phy_devices.
+# (IN_MP_PHY also implies IN_QCA808X_PHY, because src/hsl/phy/mpge_phy.c
+# and mpge_led.c call qca808x_phy_* directly - see the qca808x patch.)
+SSDK_SWCONFIG = disable
+SSDK_ISISC = disable
+SSDK_MP_PHY = FALSE
+SSDK_QCA803X_PHY = FALSE
+SSDK_QCA808X_PHY = FALSE
+
+ifeq ($(CONFIG_TARGET_SUBTARGET), "ipq50xx")
